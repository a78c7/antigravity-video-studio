[Unit]
Description=Antigravity Video Studio (Self-Hosted Collab Mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agvs
Group=agvs
WorkingDirectory=/opt/agvs
EnvironmentFile=/etc/agvs/collab.env
ExecStart=/opt/agvs/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8766 --proxy-headers --workers 1
Restart=always
RestartSec=3
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/agvs/data

[Install]
WantedBy=multi-user.target
