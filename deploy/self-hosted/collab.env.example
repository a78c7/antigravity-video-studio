# ============================================================
# 反重力视频工坊（Antigravity Video Studio）
# 自托管多人协作端环境变量模板
#
# 请复制到 /etc/agvs/collab.env 并设置 chmod 640 root:agvs，
# 严禁将填写真实密码与 Token 的文件提交到任何代码仓库！
# ============================================================

# 强制启用协作脱敏模式（彻底禁用本地媒体生成与 Google/Flow/Colab 路由）
APP_MODE=cloud_collab
BRAND_NAME=反重力视频工坊

# 对外访问的 HTTPS 完整地址（替换为你的域名）
PUBLIC_STUDIO_URL=https://studio.example.com

# 会话签名密钥与本地同步令牌（请用 `openssl rand -hex 32` 分别生成）
SESSION_SECRET=<REPLACE_WITH_64_HEX_CHARS>
SYNC_API_TOKEN=<REPLACE_WITH_64_HEX_CHARS>

# 首次启动自动创建的初始团队账号（登录后请尽快修改强密码）
INIT_ADMIN_USER=admin
INIT_ADMIN_NAME=管理员
INIT_ADMIN_PASS=<CHANGE_THIS_ADMIN_PASSWORD>

INIT_PARTNER_USER=member
INIT_PARTNER_NAME=协作成员
INIT_PARTNER_PASS=<CHANGE_THIS_MEMBER_PASSWORD>

# 可选：在协作端启用文本模型辅助生成评论回复草稿（默认关闭）
DEEPSEEK_ENABLED=false
DEEPSEEK_MODEL=deepseek-chat
DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 也可通过只读密钥文件加载（优先级低于 DEEPSEEK_API_KEY）：
DEEPSEEK_KEY_FILE=

# 可选：接入自建或托管的开源 ntfy 推送服务（默认关闭）
NTFY_ENABLED=false
NTFY_INTERNAL_URL=http://127.0.0.1:2586
NTFY_PUBLIC_URL=
NTFY_TOPIC_ADMIN=
NTFY_TOPIC_PARTNER=
NTFY_TOKEN=
