# ============================================================
# 反重力视频工坊（Antigravity Video Studio）— 非敏感配置示例
# 说明：
#   1. 首次使用建议直接启动服务后在网页「系统设置」或通过 Antigravity Skill 向导配置；
#   2. 如需手动编辑，请复制本文件为 .env（.env 与 .secrets.env 均已被 .gitignore 忽略）；
#   3. 敏感密钥请勿提交至任何代码仓库：
#      - macOS 自动存入系统钥匙串（service: antigravity-video-studio）
#      - Windows / Linux 自动存入受控文件 .secrets.env 或进程环境变量
# ============================================================

# 运行模式：local_producer（默认单机全功能）| cloud_collab（可选自托管多人协作服务端）
APP_MODE=local_producer

# 站点品牌显示名称
BRAND_NAME=反重力视频工坊

# Google 订阅档位预设：free | ai_pro | ai_ultra | ai_ultra_dev | custom
SUBSCRIPTION_TIER=custom

# 可选功能开关
ENABLE_HOT_FEEDS=true
ENABLE_CLOUD_COLLAB=false

# Google Gemini 文本模型配置（密钥留空，建议在网页「系统设置」安全保存）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 仅对 Google 域名使用的本机代理地址（留空则直连；按需填写如 http://127.0.0.1:<PORT>）
GOOGLE_PROXY_URL=

# 默认文本模型提供方：gemini（默认）| deepseek（备用）
DEFAULT_PROVIDER=gemini

# 可选备用文本模型（默认关闭，不产生额外费用）
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 官方 gemini-api CLI 媒体模型 ID 与可选自定义单价（JSON 格式，留空则沿用内置默认值）
CLI_IMAGE_MODEL=gemini-nano-banana-2.1
CLI_VIDEO_MODEL=gemini-omni-1.2-flash
CLI_MUSIC_MODEL=lyria-3.5
CLI_TTS_MODEL=gemini-3.8-flash-tts
CLI_PRICING_JSON=

# 本地素材收件箱监听目录与 Flow 归档选项
WATCH_DOWNLOADS_DIR=~/Downloads
DOCK_DRAG_DIR=
INBOX_FILTER_MODE=flow_only
KEEP_CHINESE_COPY_ON_CLAIM=true
AUTO_RENAME_FLOW_DOWNLOADS=true
AUTO_TRASH_REJECTED_BATCH=true

# Google Colab 云端 4K HDR 渲染配置（可选，OAuth 令牌由官方 CLI 独立托管）
COLAB_API_BASE=https://colaboratory.googleapis.com/v1beta
COLAB_MCP_ENDPOINT=https://colaboratory.googleapis.com/mcp
COLAB_DEFAULT_GPU=L4
COLAB_CLI_PATH=
COLAB_GDRIVE_ROOT=AntigravityVideoStudio

# 可选：自托管远程协作服务端连接配置（默认单机模式留空即可）
CLOUD_STUDIO_URL=
SYNC_API_TOKEN=
